{
  "schema": 1,
  "sites": {
    "youtube": {
      "match": "^https://(www|m)\\.youtube\\.com/(watch|live/)",
      "video": "video.html5-main-video",
      "chatPopoutUrl": "https://www.youtube.com/live_chat?is_popout=1&v={videoId}",
      "idFrom": { "param": "v" }
    },
    "chzzk": {
      "match": "^https://chzzk\\.naver\\.com/live/",
      "video": "video.webplayer-internal-video",
      "chatPopoutUrl": "https://chzzk.naver.com/live/{channelId}/chat",
      "idFrom": { "pathIndex": 2 }
    },
    "chzzkVod": {
      "match": "^https://chzzk\\.naver\\.com/video/",
      "video": "video.webplayer-internal-video",
      "chatPopoutUrl": null
    },
    "soop": {
      "match": "^https://(play|vod)\\.sooplive\\.(com|co\\.kr)/",
      "video": "video.af_video",
      "chatPopoutUrl": null
    },
    "twitch": {
      "match": "^https://www\\.twitch\\.tv/[^/?#]+/?([?#].*)?$",
      "video": "video",
      "chatPopoutUrl": "https://www.twitch.tv/popout/{channel}/chat",
      "idFrom": { "pathIndex": 1 }
    },
    "twitchVod": {
      "match": "^https://www\\.twitch\\.tv/(videos/\\d+|[^/]+/clip/)",
      "video": "video",
      "chatPopoutUrl": null
    },
    "netflix": { "match": "^https://www\\.netflix\\.com/", "chatPopoutUrl": null },
    "disneyplus": { "match": "^https://(www\\.)?disneyplus\\.com/", "chatPopoutUrl": null },
    "primevideo": {
      "match": "^https://(www\\.)?(primevideo\\.com/|amazon\\.(com|co\\.jp|co\\.uk|de|fr|it|es|ca|in|com\\.au|com\\.br|com\\.mx)/gp/video/)",
      "chatPopoutUrl": null
    },
    "coupangplay": { "match": "^https://(www\\.)?coupangplay\\.com/", "chatPopoutUrl": null },
    "tving": { "match": "^https://(www\\.)?tving\\.com/", "chatPopoutUrl": null },
    "wavve": { "match": "^https://(www\\.)?wavve\\.com/", "chatPopoutUrl": null },
    "watcha": { "match": "^https://(www\\.)?watcha\\.com/", "chatPopoutUrl": null },
    "laftel": { "match": "^https://(www\\.)?laftel\\.net/", "chatPopoutUrl": null },
    "serieson": { "match": "^https://serieson\\.naver\\.com/", "chatPopoutUrl": null },
    "appletv": { "match": "^https://tv\\.apple\\.com/", "chatPopoutUrl": null },
    "max": { "match": "^https://(play\\.)?(max|hbomax)\\.com/", "chatPopoutUrl": null },
    "hulu": { "match": "^https://www\\.hulu\\.com/", "chatPopoutUrl": null },
    "paramountplus": { "match": "^https://www\\.paramountplus\\.com/", "chatPopoutUrl": null },
    "peacock": { "match": "^https://www\\.peacocktv\\.com/", "chatPopoutUrl": null },
    "crunchyroll": { "match": "^https://www\\.crunchyroll\\.com/", "chatPopoutUrl": null }
  }
}
