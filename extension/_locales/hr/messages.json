  "guideTitle": {
    "message": "Prvi koraci s GhostPiP"
  },
  "guideSub": {
    "message": "Prozirni PiP koji propušta klikove i automatski izmiče, a nikad ne zaklanja zaslon"
  },
  "guideCheckingEngine": {
    "message": "Provjera motora…"
  },
  "guideChecking": {
    "message": "Provjera…"
  },
  "guideEngineMissing": {
    "message": "Motor nije instaliran"
  },
  "guideStep1Title": {
    "message": "1. Zadržite pokazivač iznad videozapisa"
  },
  "guideStep1Body": {
    "message": "Na vrhu videozapisa na servisima YouTube, Twitch, CHZZK, SOOP i OTT uslugama kao što su Netflix, Disney+ i Prime Video pojavljuju se dva gumba."
  },
  "guideWebModeBody": {
    "message": "Plutajući prozor unutar kartice preglednika. Prati vas na druge kartice. Ništa ne treba instalirati."
  },
  "guideFullModeBody": {
    "message": "Prozor koji lebdi iznad igara i drugih programa. Za neprozirnost, propuštanje klikova i automatsko izmicanje potreban je <b>GhostPiP Engine</b>."
  },
  "guideStep2Title": {
    "message": "2. Instalirajte GhostPiP Engine (puni način, Windows)"
  },
  "guideStep2a": {
    "message": "Raspakirajte <code>GhostPiP-Full-Package.zip</code> (ili <code>GhostPiP-Engine-win-x64.zip</code>)."
  },
  "guideStep2b": {
    "message": "Dvaput kliknite <code>engine\\install.bat</code>. Administratorska prava nisu potrebna."
  },
  "guideStep2c": {
    "message": "Gotovo je kad se status u gornjem desnom kutu ove stranice promijeni u <b>Motor povezan</b>."
  },
  "guideRetry": {
    "message": "Ponovno provjeri vezu"
  },
  "guideEngineNote": {
    "message": "Motor se instalira u <code>%LOCALAPPDATA%\\Programs\\GhostPiP</code>, radi samo dok je u Chromeu otvoren puni način i zatvara se kad isključite GhostPiP. Za uklanjanje pokrenite <code>uninstall.bat</code>."
  },
  "guideAvTitle": {
    "message": "Ako antivirusni program blokira motor"
  },
  "guideAvBody": {
    "message": "Motor prikazuje prozirni prozor iznad drugih prozora i prosljeđuje unos mišem, pa neki antivirusni programi (npr. Avast <code>Win64:Evo-gen</code>) mogu greškom označiti nepotpisane verzije. Nikad ne koristi mrežu niti prikuplja datoteke."
  },
  "guideAv1": {
    "message": "Vratite <code>GhostPiP.Engine.exe</code> iz karantene antivirusnog programa."
  },
  "guideAv2": {
    "message": "Dodajte mapu <code>%LOCALAPPDATA%\\Programs\\GhostPiP</code> u iznimke antivirusnog programa."
  },
  "guideAv3": {
    "message": "Ponovno pokrenite <code>install.bat</code>."
  },
