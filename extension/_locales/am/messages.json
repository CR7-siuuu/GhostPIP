  "guideStep1Title": {
    "message": "1. መዳፊቱን በቪዲዮ ላይ ያንዣብቡ"
  },
  "guideStep1Body": {
    "message": "በYouTube፣ Twitch፣ CHZZK፣ SOOP እና እንደ Netflix፣ Disney+ እና Prime Video ባሉ የOTT አገልግሎቶች ላይ በቪዲዮዎች አናት ሁለት አዝራሮች ይታያሉ።"
  },
  "guideWebModeBody": {
    "message": "በአሳሽ ትር ውስጥ የሚንሳፈፍ መስኮት። ወደ ሌሎች ትሮችም ይከተልዎታል። ምንም መጫን አያስፈልግም።"
  },
  "guideFullModeBody": {
    "message": "ከጨዋታዎች እና ከሌሎች ፕሮግራሞች በላይ የሚንሳፈፍ መስኮት። ግልጽ አለመሆን፣ ጠቅታ ማሳለፍ እና ራስ-ሰር ማምለጥ <b>GhostPiP Engine</b> ያስፈልጋቸዋል።"
  },
  "guideStep2Title": {
    "message": "2. GhostPiP Engineን ይጫኑ (ሙሉ ሁነታ፣ Windows)"
  },
  "guideStep2a": {
    "message": "<code>GhostPiP-Full-Package.zip</code> (ወይም <code>GhostPiP-Engine-win-x64.zip</code>) ከዚፕ ያውጡ።"
  },
  "guideStep2b": {
    "message": "<code>engine\\install.bat</code> ላይ ሁለቴ ጠቅ ያድርጉ። የአስተዳዳሪ መብቶች አያስፈልጉም።"
  },
  "guideStep2c": {
    "message": "በዚህ ገጽ ላይኛው ቀኝ ጥግ ያለው ሁኔታ ወደ <b>ሞተሩ ተገናኝቷል</b> ሲቀየር ጨርሰዋል።"
  },
  "guideRetry": {
    "message": "ግንኙነቱን እንደገና አረጋግጥ"
  },
  "guideEngineNote": {
    "message": "ሞተሩ በ<code>%LOCALAPPDATA%\\Programs\\GhostPiP</code> ውስጥ ይጫናል፣ Chrome ሙሉ ሁነታን ሲከፍት ብቻ ይሰራል፣ GhostPiPን ሲያጠፉም ይዘጋል። ለማስወገድ <code>uninstall.bat</code>ን ያሂዱ።"
  },
  "guideAvTitle": {
    "message": "ጸረ-ቫይረስዎ ሞተሩን ካገደ"
  },
  "guideAvBody": {
    "message": "ሞተሩ ከሌሎች መስኮቶች በላይ ግልጽ መስኮት ያሳያል እና የመዳፊት ግብዓትን ያስተላልፋል፣ ስለዚህ አንዳንድ የጸረ-ቫይረስ ምርቶች (ለምሳሌ Avast <code>Win64:Evo-gen</code>) ያልተፈረሙ ስሪቶችን በስህተት ሊጠቁሙ ይችላሉ። አውታረ መረብን በጭራሽ አይጠቀምም፣ ፋይሎችንም አይሰበስብም።"
  },
  "guideAv1": {
    "message": "<code>GhostPiP.Engine.exe</code>ን ከጸረ-ቫይረስዎ ማቆያ ወደነበረበት ይመልሱ።"
  },
  "guideAv2": {
    "message": "የ<code>%LOCALAPPDATA%\\Programs\\GhostPiP</code> አቃፊን ወደ ጸረ-ቫይረስዎ የማይካተቱ ዝርዝር ያክሉ።"
  },
  "guideAv3": {
    "message": "<code>install.bat</code>ን እንደገና ያሂዱ።"
  },
