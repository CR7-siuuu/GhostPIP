  "guideTitle": {
    "message": "GhostPiP 使用入門"
  },
  "guideSub": {
    "message": "透明、點擊穿透、自動閃避，絕不擋住畫面的 PiP"
  },
  "guideCheckingEngine": {
    "message": "正在檢查引擎…"
  },
  "guideChecking": {
    "message": "正在檢查…"
  },
  "guideEngineMissing": {
    "message": "尚未安裝引擎"
  },
  "guideStep1Title": {
    "message": "1. 將滑鼠移到影片上"
  },
  "guideStep1Body": {
    "message": "在 YouTube、Twitch、CHZZK、SOOP 以及 Netflix、Disney+、Prime Video 等 OTT 服務的影片上方會出現兩個按鈕。"
  },
  "guideFullModeBody": {
    "message": "浮在遊戲和其他程式上方的視窗。不透明度、點擊穿透和自動閃避需要 <b>GhostPiP Engine</b>。"
  },
  "guideStep2Title": {
    "message": "2. 安裝 GhostPiP Engine（完整模式，Windows）"
  },
  "guideStep2a": {
    "message": "解壓縮 <code>GhostPiP-Full-Package.zip</code>（或 <code>GhostPiP-Engine-win-x64.zip</code>）。"
  },
  "guideStep2b": {
    "message": "按兩下 <code>engine\\install.bat</code>。不需要系統管理員權限。"
  },
  "guideStep2c": {
    "message": "當本頁右上角的狀態變成 <b>引擎已連線</b> 即完成。"
  },
  "guideRetry": {
    "message": "重新檢查連線"
  },
  "guideEngineNote": {
    "message": "引擎會安裝到 <code>%LOCALAPPDATA%\\Programs\\GhostPiP</code>，只在 Chrome 開啟完整模式時執行，關閉 GhostPiP 後就會結束。如要移除，請執行 <code>uninstall.bat</code>。"
  },
  "guideAvTitle": {
    "message": "如果防毒軟體封鎖了引擎"
  },
  "guideAvBody": {
    "message": "引擎會在其他視窗上方顯示透明視窗並轉送滑鼠輸入，因此部分防毒軟體（例如 Avast <code>Win64:Evo-gen</code>）可能會誤判未簽署的版本。引擎絕不使用網路，也不會收集檔案。"
  },
  "guideAv1": {
    "message": "從防毒軟體的隔離區還原 <code>GhostPiP.Engine.exe</code>。"
  },
  "guideAv2": {
    "message": "將 <code>%LOCALAPPDATA%\\Programs\\GhostPiP</code> 資料夾加入防毒軟體的排除清單。"
  },
  "guideAv3": {
    "message": "再次執行 <code>install.bat</code>。"
  },
