  "guideTitle": {
    "message": "GhostPiP-ஐப் பயன்படுத்தத் தொடங்குதல்"
  },
  "guideSub": {
    "message": "திரையை ஒருபோதும் மறைக்காத, கிளிக் ஊடுருவலும் தானியங்கு விலகலும் கொண்ட வெளிப்படையான PiP"
  },
  "guideCheckingEngine": {
    "message": "இன்ஜினைச் சரிபார்க்கிறது…"
  },
  "guideChecking": {
    "message": "சரிபார்க்கிறது…"
  },
  "guideEngineMissing": {
    "message": "இன்ஜின் நிறுவப்படவில்லை"
  },
  "guideStep1Title": {
    "message": "1. வீடியோவின் மேல் கர்சரை வைக்கவும்"
  },
  "guideStep1Body": {
    "message": "YouTube, Twitch, CHZZK, SOOP மற்றும் Netflix, Disney+, Prime Video போன்ற OTT சேவைகளில் வீடியோக்களின் மேலே இரண்டு பட்டன்கள் தோன்றும்."
  },
  "guideWebModeBody": {
    "message": "உலாவித் தாவலுக்குள் மிதக்கும் சாளரம். பிற தாவல்களுக்கும் உங்களைப் பின்தொடரும். எதையும் நிறுவத் தேவையில்லை."
  },
  "guideFullModeBody": {
    "message": "கேம்கள் மற்றும் பிற நிரல்களின் மேல் மிதக்கும் சாளரம். ஒளிபுகாமை, கிளிக் ஊடுருவல், தானியங்கு விலகலுக்கு <b>GhostPiP Engine</b> தேவை."
  },
  "guideStep2Title": {
    "message": "2. GhostPiP Engine-ஐ நிறுவுதல் (முழுப் பயன்முறை, Windows)"
  },
  "guideStep2a": {
    "message": "<code>GhostPiP-Full-Package.zip</code> (அல்லது <code>GhostPiP-Engine-win-x64.zip</code>) கோப்பைப் பிரித்தெடுக்கவும்."
  },
  "guideStep2b": {
    "message": "<code>engine\\install.bat</code>-ஐ இருமுறை கிளிக் செய்யவும். நிர்வாகி உரிமைகள் தேவையில்லை."
  },
  "guideStep2c": {
    "message": "இந்தப் பக்கத்தின் மேல் வலதுபுறத்தில் உள்ள நிலை <b>இன்ஜின் இணைக்கப்பட்டது</b> என மாறியதும் முடிந்தது."
  },
  "guideRetry": {
    "message": "இணைப்பை மீண்டும் சரிபார்"
  },
  "guideEngineNote": {
    "message": "இன்ஜின் <code>%LOCALAPPDATA%\\Programs\\GhostPiP</code>-இல் நிறுவப்படும், Chrome-இல் முழுப் பயன்முறை திறந்திருக்கும்போது மட்டும் இயங்கும், GhostPiP-ஐ முடக்கும்போது வெளியேறும். அதை அகற்ற <code>uninstall.bat</code>-ஐ இயக்கவும்."
  },
  "guideAvTitle": {
    "message": "வைரஸ் தடுப்பு இன்ஜினைத் தடுத்தால்"
  },
  "guideAvBody": {
    "message": "இன்ஜின் பிற சாளரங்களின் மேல் வெளிப்படையான சாளரத்தைக் காட்டி மவுஸ் உள்ளீட்டை அனுப்புவதால், சில வைரஸ் தடுப்பு நிரல்கள் (எ.கா. Avast <code>Win64:Evo-gen</code>) கையொப்பமிடாத பதிப்புகளைத் தவறாகக் குறிக்கலாம். இது ஒருபோதும் நெட்வொர்க்கைப் பயன்படுத்தாது, கோப்புகளைச் சேகரிக்காது."
  },
  "guideAv1": {
    "message": "வைரஸ் தடுப்பு தனிமைப்படுத்தலில் இருந்து <code>GhostPiP.Engine.exe</code>-ஐ மீட்டெடுக்கவும்."
  },
  "guideAv2": {
    "message": "<code>%LOCALAPPDATA%\\Programs\\GhostPiP</code> கோப்புறையை வைரஸ் தடுப்பு விலக்குகளில் சேர்க்கவும்."
  },
  "guideAv3": {
    "message": "<code>install.bat</code>-ஐ மீண்டும் இயக்கவும்."
  },
