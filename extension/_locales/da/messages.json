  "guideStep1Title": {
    "message": "1. Hold musen over en video"
  },
  "guideStep1Body": {
    "message": "Der vises to knapper øverst på videoer på YouTube, Twitch, CHZZK, SOOP og OTT-tjenester som Netflix, Disney+ og Prime Video."
  },
  "guideWebModeBody": {
    "message": "Et svævende vindue i browserfanen. Det følger med til andre faner. Intet at installere."
  },
  "guideFullModeBody": {
    "message": "Et vindue, der svæver over spil og andre programmer. Opacitet, klik igennem og automatisk undvigelse kræver <b>GhostPiP Engine</b>."
  },
  "guideStep2Title": {
    "message": "2. Installer GhostPiP Engine (fuld tilstand, Windows)"
  },
  "guideStep2a": {
    "message": "Udpak <code>GhostPiP-Full-Package.zip</code> (eller <code>GhostPiP-Engine-win-x64.zip</code>)."
  },
  "guideStep2b": {
    "message": "Dobbeltklik på <code>engine\\install.bat</code>. Kræver ikke administratorrettigheder."
  },
  "guideStep2c": {
    "message": "Du er færdig, når status øverst til højre på denne side skifter til <b>Motor forbundet</b>."
  },
  "guideRetry": {
    "message": "Tjek forbindelsen igen"
  },
  "guideEngineNote": {
    "message": "Motoren installeres i <code>%LOCALAPPDATA%\\Programs\\GhostPiP</code>, kører kun, mens Chrome har fuld tilstand åben, og lukker, når du slår GhostPiP fra. Kør <code>uninstall.bat</code> for at fjerne den."
  },
  "guideAvTitle": {
    "message": "Hvis dit antivirus blokerer motoren"
  },
  "guideAvBody": {
    "message": "Motoren viser et gennemsigtigt vindue over andre vinduer og videresender museinput, så nogle antivirusprogrammer (f.eks. Avast <code>Win64:Evo-gen</code>) kan fejlagtigt markere usignerede builds. Den bruger aldrig netværket og indsamler ingen filer."
  },
  "guideAv1": {
    "message": "Gendan <code>GhostPiP.Engine.exe</code> fra dit antivirusprograms karantæne."
  },
  "guideAv2": {
    "message": "Føj mappen <code>%LOCALAPPDATA%\\Programs\\GhostPiP</code> til dit antivirusprograms undtagelser."
  },
  "guideAv3": {
    "message": "Kør <code>install.bat</code> igen."
  },
