  "guideTitle": {
    "message": "GhostPiP – aloitusopas"
  },
  "guideSub": {
    "message": "Läpinäkyvä, läpiklikattava ja automaattisesti väistävä PiP, joka ei koskaan peitä näyttöäsi"
  },
  "guideCheckingEngine": {
    "message": "Tarkistetaan moottoria…"
  },
  "guideChecking": {
    "message": "Tarkistetaan…"
  },
  "guideEngineMissing": {
    "message": "Moottoria ei ole asennettu"
  },
  "guideStep1Title": {
    "message": "1. Vie hiiri videon päälle"
  },
  "guideStep1Body": {
    "message": "Videoiden yläosaan ilmestyy kaksi painiketta palveluissa YouTube, Twitch, CHZZK ja SOOP sekä OTT-palveluissa, kuten Netflix, Disney+ ja Prime Video."
  },
  "guideWebModeBody": {
    "message": "Kelluva ikkuna selaimen välilehdellä. Se seuraa sinua muille välilehdille. Ei asennettavaa."
  },
  "guideFullModeBody": {
    "message": "Ikkuna, joka kelluu pelien ja muiden ohjelmien päällä. Peittävyys, läpiklikkaus ja automaattinen väistö vaativat <b>GhostPiP Engine</b> -ohjelman."
  },
  "guideStep2Title": {
    "message": "2. Asenna GhostPiP Engine (täysi tila, Windows)"
  },
  "guideStep2a": {
    "message": "Pura <code>GhostPiP-Full-Package.zip</code> (tai <code>GhostPiP-Engine-win-x64.zip</code>)."
  },
  "guideStep2b": {
    "message": "Kaksoisnapsauta <code>engine\\install.bat</code>. Järjestelmänvalvojan oikeuksia ei tarvita."
  },
  "guideStep2c": {
    "message": "Valmista, kun tämän sivun oikean yläkulman tilaksi vaihtuu <b>Moottori yhdistetty</b>."
  },
  "guideRetry": {
    "message": "Tarkista yhteys uudelleen"
  },
  "guideEngineNote": {
    "message": "Moottori asennetaan kansioon <code>%LOCALAPPDATA%\\Programs\\GhostPiP</code>, se on käynnissä vain, kun täysi tila on auki Chromessa, ja sulkeutuu, kun GhostPiP poistetaan käytöstä. Poista se suorittamalla <code>uninstall.bat</code>."
  },
  "guideAvTitle": {
    "message": "Jos virustorjunta estää moottorin"
  },
  "guideAvBody": {
    "message": "Moottori näyttää läpinäkyvän ikkunan muiden ikkunoiden päällä ja välittää hiiren syötteen, joten jotkin virustorjuntaohjelmat (esim. Avast <code>Win64:Evo-gen</code>) voivat merkitä allekirjoittamattomat versiot virheellisesti. Se ei koskaan käytä verkkoa eikä kerää tiedostoja."
  },
  "guideAv1": {
    "message": "Palauta <code>GhostPiP.Engine.exe</code> virustorjunnan karanteenista."
  },
  "guideAv2": {
    "message": "Lisää kansio <code>%LOCALAPPDATA%\\Programs\\GhostPiP</code> virustorjunnan poikkeuksiin."
  },
  "guideAv3": {
    "message": "Suorita <code>install.bat</code> uudelleen."
  },
