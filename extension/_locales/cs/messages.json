  "guideEngineMissing": {
    "message": "Jádro není nainstalováno"
  },
  "guideStep1Title": {
    "message": "1. Najeďte myší na video"
  },
  "guideStep1Body": {
    "message": "V horní části videí na YouTube, Twitch, CHZZK, SOOP a OTT službách jako Netflix, Disney+ a Prime Video se zobrazí dvě tlačítka."
  },
  "guideFullModeBody": {
    "message": "Okno, které se vznáší nad hrami a dalšími programy. Neprůhlednost, proklikávání a automatické uhýbání vyžadují <b>GhostPiP Engine</b>."
  },
  "guideStep2Title": {
    "message": "2. Instalace GhostPiP Engine (plný režim, Windows)"
  },
  "guideStep2a": {
    "message": "Rozbalte <code>GhostPiP-Full-Package.zip</code> (nebo <code>GhostPiP-Engine-win-x64.zip</code>)."
  },
  "guideStep2b": {
    "message": "Dvakrát klikněte na <code>engine\\install.bat</code>. Nejsou potřeba práva správce."
  },
  "guideStep2c": {
    "message": "Hotovo, jakmile se stav vpravo nahoře na této stránce změní na <b>Jádro připojeno</b>."
  },
  "guideRetry": {
    "message": "Znovu zkontrolovat připojení"
  },
  "guideEngineNote": {
    "message": "Jádro se instaluje do <code>%LOCALAPPDATA%\\Programs\\GhostPiP</code>, běží jen tehdy, když má Chrome otevřený plný režim, a ukončí se, když GhostPiP vypnete. Odinstalujete ho spuštěním <code>uninstall.bat</code>."
  },
  "guideAvTitle": {
    "message": "Pokud antivirus blokuje jádro"
  },
  "guideAvBody": {
    "message": "Jádro zobrazuje průhledné okno nad ostatními okny a přeposílá vstup myši, proto ho některé antiviry (např. Avast <code>Win64:Evo-gen</code>) mohou v nepodepsaném sestavení omylem označit. Nikdy nepoužívá síť ani neshromažďuje soubory."
  },
  "guideAv1": {
    "message": "Obnovte <code>GhostPiP.Engine.exe</code> z karantény antiviru."
  },
  "guideAv2": {
    "message": "Přidejte složku <code>%LOCALAPPDATA%\\Programs\\GhostPiP</code> do výjimek antiviru."
  },
  "guideAv3": {
    "message": "Znovu spusťte <code>install.bat</code>."
  },
