  "guideTitle": {
    "message": "Začínáme s GhostPiP"
  },
  "guideSub": {
    "message": "Průhledné PiP s proklikáváním a automatickým uhýbáním, které nikdy nezakrývá obrazovku"
  },
  "guideCheckingEngine": {
