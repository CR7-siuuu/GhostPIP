  },
  "guideChecking": {
    "message": "Pārbauda…"
  },
  "guideEngineMissing": {
    "message": "Dzinējs nav instalēts"
  },
  "guideStep1Title": {
    "message": "1. Novietojiet kursoru virs video"
  },
  "guideStep1Body": {
    "message": "Video augšdaļā parādās divas pogas vietnēs YouTube, Twitch, CHZZK, SOOP un OTT pakalpojumos, piemēram, Netflix, Disney+ un Prime Video."
  },
  "guideWebModeBody": {
    "message": "Peldošs logs pārlūka cilnē. Tas seko jums uz citām cilnēm. Nekas nav jāinstalē."
  },
  "guideFullModeBody": {
    "message": "Logs, kas peld virs spēlēm un citām programmām. Necaurredzamībai, klikšķu caurlaidībai un automātiskai izvairīšanās ir nepieciešams <b>GhostPiP Engine</b>."
  },
  "guideStep2Title": {
    "message": "2. Instalējiet GhostPiP Engine (pilnais režīms, Windows)"
  },
  "guideStep2a": {
    "message": "Izpakojiet <code>GhostPiP-Full-Package.zip</code> (vai <code>GhostPiP-Engine-win-x64.zip</code>)."
  },
  "guideStep2b": {
    "message": "Veiciet dubultklikšķi uz <code>engine\\install.bat</code>. Administratora tiesības nav vajadzīgas."
  },
  "guideStep2c": {
    "message": "Gatavs, kad statuss šīs lapas augšējā labajā stūrī mainās uz <b>Dzinējs savienots</b>."
  },
  "guideRetry": {
    "message": "Vēlreiz pārbaudīt savienojumu"
  },
  "guideEngineNote": {
    "message": "Dzinējs tiek instalēts mapē <code>%LOCALAPPDATA%\\Programs\\GhostPiP</code>, darbojas tikai tad, kad pārlūkā Chrome ir atvērts pilnais režīms, un beidz darbu, kad izslēdzat GhostPiP. Lai to noņemtu, palaidiet <code>uninstall.bat</code>."
  },
  "guideAvTitle": {
    "message": "Ja antivīruss bloķē dzinēju"
  },
  "guideAvBody": {
    "message": "Dzinējs rāda caurspīdīgu logu virs citiem logiem un pārsūta peles ievadi, tāpēc daži antivīrusi (piem., Avast <code>Win64:Evo-gen</code>) var kļūdaini atzīmēt neparakstītas versijas. Tas nekad neizmanto tīklu un nevāc failus."
  },
  "guideAv1": {
    "message": "Atjaunojiet <code>GhostPiP.Engine.exe</code> no antivīrusa karantīnas."
  },
  "guideAv2": {
    "message": "Pievienojiet mapi <code>%LOCALAPPDATA%\\Programs\\GhostPiP</code> antivīrusa izņēmumiem."
  },
  "guideAv3": {
    "message": "Vēlreiz palaidiet <code>install.bat</code>."
  },
