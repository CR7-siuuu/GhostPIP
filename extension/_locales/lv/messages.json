  "guideTitle": {
    "message": "Darba sākšana ar GhostPiP"
  },
  "guideSub": {
    "message": "Caurspīdīgs PiP ar klikšķu caurlaidību un automātisku izvairīšanos, kas nekad neaizsedz ekrānu"
  },
