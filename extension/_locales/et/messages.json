  "guideEngineMissing": {
    "message": "Mootor pole installitud"
  },
  "guideStep1Title": {
    "message": "1. Vii kursor video kohale"
  },
  "guideStep1Body": {
    "message": "Videote ülaossa ilmub kaks nuppu saitidel YouTube, Twitch, CHZZK, SOOP ja OTT-teenustes, nagu Netflix, Disney+ ja Prime Video."
  },
  "guideWebModeBody": {
    "message": "Hõljuv aken brauseri vahekaardil. See järgneb sulle teistele vahekaartidele. Midagi pole vaja installida."
  },
  "guideFullModeBody": {
    "message": "Aken, mis hõljub mängude ja teiste programmide kohal. Läbipaistmatus, läbiklõps ja automaatne põiklemine vajavad rakendust <b>GhostPiP Engine</b>."
  },
  "guideStep2Title": {
    "message": "2. Installi GhostPiP Engine (täisrežiim, Windows)"
  },
  "guideStep2a": {
    "message": "Paki lahti <code>GhostPiP-Full-Package.zip</code> (või <code>GhostPiP-Engine-win-x64.zip</code>)."
  },
  "guideStep2b": {
    "message": "Topeltklõpsa failil <code>engine\\install.bat</code>. Administraatoriõigusi pole vaja."
  },
  "guideStep2c": {
    "message": "Valmis, kui selle lehe paremas ülanurgas olev olek muutub: <b>Mootor ühendatud</b>."
  },
  "guideRetry": {
    "message": "Kontrolli ühendust uuesti"
  },
  "guideEngineNote": {
    "message": "Mootor installitakse kausta <code>%LOCALAPPDATA%\\Programs\\GhostPiP</code>, töötab ainult siis, kui Chrome'is on täisrežiim avatud, ja sulgub, kui GhostPiP välja lülitatakse. Eemaldamiseks käivita <code>uninstall.bat</code>."
  },
  "guideAvTitle": {
    "message": "Kui viirusetõrje blokeerib mootori"
  },
  "guideAvBody": {
    "message": "Mootor kuvab teiste akende kohal läbipaistvat akent ja edastab hiire sisendit, seega võivad mõned viirusetõrjed (nt Avast <code>Win64:Evo-gen</code>) allkirjastamata järke ekslikult märgistada. See ei kasuta kunagi võrku ega kogu faile."
  },
  "guideAv1": {
    "message": "Taasta <code>GhostPiP.Engine.exe</code> viirusetõrje karantiinist."
  },
  "guideAv2": {
    "message": "Lisa kaust <code>%LOCALAPPDATA%\\Programs\\GhostPiP</code> viirusetõrje erandite hulka."
  },
  "guideAv3": {
    "message": "Käivita <code>install.bat</code> uuesti."
  },
