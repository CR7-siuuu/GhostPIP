  "guideStep1Title": {
    "message": "1. ഒരു വീഡിയോയ്ക്ക് മുകളിൽ കഴ്സർ വയ്ക്കുക"
  },
  "guideStep1Body": {
    "message": "YouTube, Twitch, CHZZK, SOOP എന്നിവയിലും Netflix, Disney+, Prime Video പോലുള്ള OTT സേവനങ്ങളിലും വീഡിയോകളുടെ മുകളിൽ രണ്ട് ബട്ടണുകൾ ദൃശ്യമാകും."
  },
  "guideWebModeBody": {
    "message": "ബ്രൗസർ ടാബിനുള്ളിൽ ഒഴുകിനിൽക്കുന്ന വിൻഡോ. മറ്റ് ടാബുകളിലേക്കും ഇത് നിങ്ങളെ പിന്തുടരും. ഒന്നും ഇൻസ്റ്റാൾ ചെയ്യേണ്ടതില്ല."
  },
  "guideFullModeBody": {
    "message": "ഗെയിമുകൾക്കും മറ്റ് പ്രോഗ്രാമുകൾക്കും മുകളിൽ ഒഴുകിനിൽക്കുന്ന വിൻഡോ. അതാര്യത, ക്ലിക്ക്-ത്രൂ, സ്വയം ഒഴിഞ്ഞുമാറൽ എന്നിവയ്ക്ക് <b>GhostPiP Engine</b> ആവശ്യമാണ്."
  },
  "guideStep2Title": {
    "message": "2. GhostPiP Engine ഇൻസ്റ്റാൾ ചെയ്യുക (ഫുൾ മോഡ്, Windows)"
  },
  "guideStep2a": {
    "message": "<code>GhostPiP-Full-Package.zip</code> (അല്ലെങ്കിൽ <code>GhostPiP-Engine-win-x64.zip</code>) അൺസിപ്പ് ചെയ്യുക."
  },
  "guideStep2b": {
    "message": "<code>engine\\install.bat</code> ഡബിൾ ക്ലിക്ക് ചെയ്യുക. അഡ്മിനിസ്ട്രേറ്റർ അവകാശങ്ങൾ ആവശ്യമില്ല."
  },
  "guideStep2c": {
    "message": "ഈ പേജിന്റെ മുകളിൽ വലതുവശത്തുള്ള നില <b>എഞ്ചിൻ കണക്റ്റ് ചെയ്തു</b> എന്ന് മാറുമ്പോൾ പൂർത്തിയായി."
  },
  "guideRetry": {
    "message": "കണക്ഷൻ വീണ്ടും പരിശോധിക്കുക"
  },
  "guideEngineNote": {
    "message": "എഞ്ചിൻ <code>%LOCALAPPDATA%\\Programs\\GhostPiP</code> എന്നതിലേക്ക് ഇൻസ്റ്റാൾ ചെയ്യപ്പെടുന്നു, Chrome-ൽ ഫുൾ മോഡ് തുറന്നിരിക്കുമ്പോൾ മാത്രം പ്രവർത്തിക്കുന്നു, GhostPiP ഓഫാക്കുമ്പോൾ അവസാനിക്കുന്നു. നീക്കം ചെയ്യാൻ <code>uninstall.bat</code> റൺ ചെയ്യുക."
  },
  "guideAvTitle": {
    "message": "ആന്റിവൈറസ് എഞ്ചിനെ തടയുന്നുവെങ്കിൽ"
  },
  "guideAvBody": {
    "message": "എഞ്ചിൻ മറ്റ് വിൻഡോകൾക്ക് മുകളിൽ സുതാര്യമായ വിൻഡോ കാണിക്കുകയും മൗസ് ഇൻപുട്ട് കൈമാറുകയും ചെയ്യുന്നതിനാൽ, ചില ആന്റിവൈറസുകൾ (ഉദാ. Avast <code>Win64:Evo-gen</code>) ഒപ്പിടാത്ത ബിൽഡുകളെ തെറ്റായി ഫ്ലാഗ് ചെയ്തേക്കാം. ഇത് ഒരിക്കലും നെറ്റ്‌വർക്ക് ഉപയോഗിക്കുകയോ ഫയലുകൾ ശേഖരിക്കുകയോ ചെയ്യുന്നില്ല."
  },
  "guideAv1": {
    "message": "ആന്റിവൈറസ് ക്വാറന്റൈനിൽ നിന്ന് <code>GhostPiP.Engine.exe</code> പുനഃസ്ഥാപിക്കുക."
  },
  "guideAv2": {
    "message": "<code>%LOCALAPPDATA%\\Programs\\GhostPiP</code> ഫോൾഡർ ആന്റിവൈറസ് ഒഴിവാക്കലുകളിലേക്ക് ചേർക്കുക."
  },
  "guideAv3": {
    "message": "<code>install.bat</code> വീണ്ടും റൺ ചെയ്യുക."
  },
