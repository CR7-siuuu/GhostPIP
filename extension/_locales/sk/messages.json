  "guideTitle": {
    "message": "Začíname s GhostPiP"
  },
  "guideSub": {
    "message": "Priehľadné PiP s preklikávaním a automatickým uhýbaním, ktoré nikdy nezakryje obrazovku"
  },
  "guideCheckingEngine": {
    "message": "Kontroluje sa jadro…"
  },
  "guideChecking": {
    "message": "Kontroluje sa…"
  },
  "guideEngineMissing": {
    "message": "Jadro nie je nainštalované"
  },
  "guideStep1Title": {
    "message": "1. Prejdite kurzorom nad video"
  },
  "guideStep1Body": {
    "message": "V hornej časti videí na YouTube, Twitch, CHZZK, SOOP a OTT službách ako Netflix, Disney+ a Prime Video sa zobrazia dve tlačidlá."
  },
  "guideWebModeBody": {
    "message": "Plávajúce okno v karte prehliadača. Nasleduje vás do ďalších kariet. Nič netreba inštalovať."
  },
  "guideFullModeBody": {
    "message": "Okno, ktoré pláva nad hrami a inými programami. Nepriehľadnosť, preklikávanie a automatické uhýbanie vyžadujú <b>GhostPiP Engine</b>."
  },
  "guideStep2Title": {
    "message": "2. Nainštalujte GhostPiP Engine (úplný režim, Windows)"
  },
  "guideStep2a": {
    "message": "Rozbaľte <code>GhostPiP-Full-Package.zip</code> (alebo <code>GhostPiP-Engine-win-x64.zip</code>)."
  },
  "guideStep2b": {
    "message": "Dvakrát kliknite na <code>engine\\install.bat</code>. Nevyžaduje práva správcu."
  },
  "guideStep2c": {
    "message": "Hotovo, keď sa stav vpravo hore na tejto stránke zmení na <b>Jadro pripojené</b>."
  },
  "guideRetry": {
    "message": "Znova skontrolovať pripojenie"
  },
  "guideEngineNote": {
    "message": "Jadro sa inštaluje do <code>%LOCALAPPDATA%\\Programs\\GhostPiP</code>, beží len vtedy, keď má Chrome otvorený úplný režim, a ukončí sa po vypnutí GhostPiP. Ak ho chcete odstrániť, spustite <code>uninstall.bat</code>."
  },
  "guideAvTitle": {
    "message": "Ak antivírus blokuje jadro"
  },
  "guideAvBody": {
    "message": "Jadro zobrazuje priehľadné okno nad inými oknami a preposiela vstup myši, preto niektoré antivírusy (napr. Avast <code>Win64:Evo-gen</code>) môžu omylom označiť nepodpísané zostavy. Nikdy nepoužíva sieť ani nezhromažďuje súbory."
  },
  "guideAv1": {
    "message": "Obnovte <code>GhostPiP.Engine.exe</code> z karantény antivírusu."
  },
  "guideAv2": {
    "message": "Pridajte priečinok <code>%LOCALAPPDATA%\\Programs\\GhostPiP</code> do výnimiek antivírusu."
  },
  "guideAv3": {
    "message": "Znova spustite <code>install.bat</code>."
  },
