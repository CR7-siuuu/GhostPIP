  "guideEngineMissing": {
    "message": "Variklis neįdiegtas"
  },
  "guideStep1Title": {
    "message": "1. Užveskite žymeklį ant vaizdo įrašo"
  },
  "guideStep1Body": {
    "message": "Du mygtukai atsiranda vaizdo įrašų viršuje YouTube, Twitch, CHZZK, SOOP ir OTT paslaugose, pvz., Netflix, Disney+ ir Prime Video."
  },
  "guideWebModeBody": {
    "message": "Slankusis langas naršyklės skirtuke. Seka jus į kitus skirtukus. Nieko diegti nereikia."
  },
  "guideFullModeBody": {
    "message": "Langas, rodomas virš žaidimų ir kitų programų. Nepermatomumui, spustelėjimų praleidimui ir automatiniam vengimui reikia <b>GhostPiP Engine</b>."
  },
  "guideStep2Title": {
    "message": "2. Įdiekite GhostPiP Engine (visas režimas, Windows)"
  },
  "guideStep2a": {
    "message": "Išarchyvuokite <code>GhostPiP-Full-Package.zip</code> (arba <code>GhostPiP-Engine-win-x64.zip</code>)."
  },
  "guideStep2b": {
    "message": "Dukart spustelėkite <code>engine\\install.bat</code>. Administratoriaus teisių nereikia."
  },
  "guideStep2c": {
    "message": "Baigta, kai būsena šio puslapio viršuje dešinėje pasikeičia į <b>Variklis prijungtas</b>."
  },
  "guideRetry": {
    "message": "Dar kartą tikrinti ryšį"
  },
  "guideEngineNote": {
    "message": "Variklis įdiegiamas į <code>%LOCALAPPDATA%\\Programs\\GhostPiP</code>, veikia tik tada, kai „Chrome“ atidarytas visas režimas, ir išsijungia, kai išjungiate GhostPiP. Norėdami pašalinti, paleiskite <code>uninstall.bat</code>."
  },
  "guideAvTitle": {
    "message": "Jei antivirusinė programa blokuoja variklį"
  },
  "guideAvBody": {
    "message": "Variklis rodo permatomą langą virš kitų langų ir perduoda pelės įvestį, todėl kai kurios antivirusinės programos (pvz., Avast <code>Win64:Evo-gen</code>) gali per klaidą pažymėti nepasirašytas versijas. Jis niekada nenaudoja tinklo ir nerenka failų."
  },
  "guideAv1": {
    "message": "Atkurkite <code>GhostPiP.Engine.exe</code> iš antivirusinės programos karantino."
  },
  "guideAv2": {
    "message": "Įtraukite aplanką <code>%LOCALAPPDATA%\\Programs\\GhostPiP</code> į antivirusinės programos išimtis."
  },
  "guideAv3": {
    "message": "Dar kartą paleiskite <code>install.bat</code>."
  },
