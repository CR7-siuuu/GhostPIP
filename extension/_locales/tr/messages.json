  "guideEngineMissing": {
    "message": "Motor yüklü değil"
  },
  "guideStep1Title": {
    "message": "1. İmleci bir videonun üzerine getirin"
  },
  "guideStep1Body": {
    "message": "YouTube, Twitch, CHZZK, SOOP ve Netflix, Disney+, Prime Video gibi OTT hizmetlerindeki videoların üstünde iki düğme görünür."
  },
  "guideWebModeBody": {
    "message": "Tarayıcı sekmesi içinde yüzen bir pencere. Diğer sekmelerde de sizi takip eder. Hiçbir şey yüklemeniz gerekmez."
  },
  "guideFullModeBody": {
    "message": "Oyunların ve diğer programların üzerinde yüzen bir pencere. Opaklık, tıklama geçirme ve otomatik kaçınma için <b>GhostPiP Engine</b> gerekir."
  },
  "guideStep2Title": {
    "message": "2. GhostPiP Engine'i yükleyin (Tam mod, Windows)"
  },
  "guideStep2a": {
    "message": "<code>GhostPiP-Full-Package.zip</code> (veya <code>GhostPiP-Engine-win-x64.zip</code>) dosyasını ayıklayın."
  },
  "guideStep2b": {
    "message": "<code>engine\\install.bat</code> dosyasına çift tıklayın. Yönetici hakları gerekmez."
  },
  "guideStep2c": {
    "message": "Bu sayfanın sağ üstündeki durum <b>Motor bağlı</b> olarak değiştiğinde işlem tamamdır."
  },
  "guideRetry": {
    "message": "Bağlantıyı yeniden kontrol et"
  },
  "guideEngineNote": {
    "message": "Motor <code>%LOCALAPPDATA%\\Programs\\GhostPiP</code> konumuna yüklenir, yalnızca Chrome'da Tam mod açıkken çalışır ve GhostPiP'i kapattığınızda kapanır. Kaldırmak için <code>uninstall.bat</code> dosyasını çalıştırın."
  },
  "guideAvTitle": {
    "message": "Antivirüsünüz motoru engellerse"
  },
  "guideAvBody": {
    "message": "Motor diğer pencerelerin üzerinde şeffaf bir pencere gösterip fare girdisini ilettiği için bazı antivirüs ürünleri (ör. Avast <code>Win64:Evo-gen</code>) imzasız sürümleri yanlışlıkla işaretleyebilir. Motor asla ağı kullanmaz ve dosya toplamaz."
  },
  "guideAv1": {
    "message": "<code>GhostPiP.Engine.exe</code> dosyasını antivirüs karantinasından geri yükleyin."
  },
  "guideAv2": {
    "message": "<code>%LOCALAPPDATA%\\Programs\\GhostPiP</code> klasörünü antivirüs istisnalarına ekleyin."
  },
  "guideAv3": {
    "message": "<code>install.bat</code> dosyasını yeniden çalıştırın."
  },
