  "guideTitle": {
    "message": "תחילת העבודה עם GhostPiP"
  },
  "guideSub": {
    "message": "PiP שקוף, מעביר לחיצות ומתחמק אוטומטית, שאף פעם לא מסתיר את המסך"
  },
