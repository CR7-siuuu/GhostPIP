  "guideTitle": {
    "message": "GhostPiP দিয়ে শুরু করুন"
  },
  "guideSub": {
    "message": "স্বচ্ছ, ক্লিক-থ্রু ও স্বয়ংক্রিয়ভাবে সরে যাওয়া PiP, যা কখনো আপনার স্ক্রিন ঢাকে না"
  },
  "guideCheckingEngine": {
    "message": "ইঞ্জিন পরীক্ষা করা হচ্ছে…"
  },
  "guideChecking": {
    "message": "পরীক্ষা করা হচ্ছে…"
  },
  "guideEngineMissing": {
    "message": "ইঞ্জিন ইনস্টল করা নেই"
  },
  "guideStep1Title": {
    "message": "১. ভিডিওর ওপর মাউস রাখুন"
  },
  "guideStep1Body": {
    "message": "YouTube, Twitch, CHZZK, SOOP এবং Netflix, Disney+ ও Prime Video-র মতো OTT পরিষেবার ভিডিওর ওপরে দুটি বোতাম দেখা যায়।"
  },
  "guideWebModeBody": {
    "message": "ব্রাউজার ট্যাবের ভেতরে একটি ভাসমান উইন্ডো। অন্য ট্যাবেও আপনার সঙ্গে যায়। কিছু ইনস্টল করতে হয় না।"
  },
  "guideFullModeBody": {
    "message": "গেম ও অন্যান্য প্রোগ্রামের ওপর ভাসমান একটি উইন্ডো। অস্বচ্ছতা, ক্লিক-থ্রু ও স্বয়ংক্রিয় সরে যাওয়ার জন্য <b>GhostPiP Engine</b> প্রয়োজন।"
  },
  "guideStep2Title": {
    "message": "২. GhostPiP Engine ইনস্টল করুন (ফুল মোড, Windows)"
  },
  "guideStep2a": {
    "message": "<code>GhostPiP-Full-Package.zip</code> (অথবা <code>GhostPiP-Engine-win-x64.zip</code>) আনজিপ করুন।"
  },
  "guideStep2b": {
    "message": "<code>engine\\install.bat</code>-এ ডাবল-ক্লিক করুন। অ্যাডমিনিস্ট্রেটর অধিকার লাগবে না।"
  },
  "guideStep2c": {
    "message": "এই পৃষ্ঠার উপরের ডানদিকের স্ট্যাটাস <b>ইঞ্জিন সংযুক্ত</b> হয়ে গেলেই কাজ শেষ।"
  },
  "guideRetry": {
    "message": "আবার সংযোগ পরীক্ষা করুন"
  },
  "guideEngineNote": {
    "message": "ইঞ্জিনটি <code>%LOCALAPPDATA%\\Programs\\GhostPiP</code>-এ ইনস্টল হয়, শুধু Chrome-এ ফুল মোড খোলা থাকলে চলে এবং GhostPiP বন্ধ করলে বন্ধ হয়ে যায়। সরাতে <code>uninstall.bat</code> চালান।"
  },
  "guideAvTitle": {
    "message": "অ্যান্টিভাইরাস ইঞ্জিন ব্লক করলে"
  },
  "guideAvBody": {
    "message": "ইঞ্জিনটি অন্য উইন্ডোর ওপর একটি স্বচ্ছ উইন্ডো দেখায় এবং মাউস ইনপুট ফরোয়ার্ড করে, তাই কিছু অ্যান্টিভাইরাস (যেমন Avast <code>Win64:Evo-gen</code>) ভুল করে স্বাক্ষরবিহীন বিল্ডকে চিহ্নিত করতে পারে। এটি কখনো নেটওয়ার্ক ব্যবহার করে না বা ফাইল সংগ্রহ করে না।"
  },
  "guideAv1": {
    "message": "অ্যান্টিভাইরাসের কোয়ারেন্টাইন থেকে <code>GhostPiP.Engine.exe</code> পুনরুদ্ধার করুন।"
  },
  "guideAv2": {
    "message": "<code>%LOCALAPPDATA%\\Programs\\GhostPiP</code> ফোল্ডারটি অ্যান্টিভাইরাসের ব্যতিক্রম তালিকায় যোগ করুন।"
  },
  "guideAv3": {
    "message": "আবার <code>install.bat</code> চালান।"
  },
