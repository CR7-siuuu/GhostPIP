{
  "manifest_version": 3,
  "name": "GhostPiP",
  "version": "1.0.0",
  "description": "화면을 가리지 않는 투명 · 클릭 통과 · 자동 회피 PiP. 유튜브, 치지직, SOOP, 트위치 지원",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "nativeMessaging",
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "chat_framing",
        "enabled": true,
        "path": "config/dnr_rules.json"
      }
    ]
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://*.youtube.com/*",
    "https://chzzk.naver.com/*",
    "https://*.sooplive.com/*",
    "https://*.sooplive.co.kr/*",
    "https://*.twitch.tv/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "GhostPiP",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {},
    "toggle-click-through": {
      "suggested_key": {
        "default": "Alt+G"
      },
      "description": "클릭 통과 (Ghost Mode) 토글"
    },
    "toggle-dodge": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "스마트 자동 회피 토글"
    },
    "toggle-mute": {
      "suggested_key": {
        "default": "Alt+M"
      },
      "description": "영상 탭 음소거 토글"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "https://*.youtube.com/*",
        "https://chzzk.naver.com/*",
        "https://*.sooplive.com/*",
        "https://*.sooplive.co.kr/*",
        "https://*.twitch.tv/*"
      ],
      "js": [
        "shared/settings.js",
        "content/dodge.js",
        "content/content.js"
      ],
      "css": [
        "content/overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
