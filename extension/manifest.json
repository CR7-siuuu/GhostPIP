{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.1.1",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "nativeMessaging",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://chzzk.naver.com/*",
    "https://play.sooplive.com/*",
    "https://vod.sooplive.com/*",
    "https://play.sooplive.co.kr/*",
    "https://vod.sooplive.co.kr/*",
    "https://www.twitch.tv/*",
    "https://www.netflix.com/*",
    "https://*.disneyplus.com/*",
    "https://*.primevideo.com/*",
    "https://*.amazon.com/*",
    "https://*.amazon.co.jp/*",
    "https://*.amazon.co.uk/*",
    "https://*.amazon.de/*",
    "https://*.amazon.fr/*",
    "https://*.amazon.it/*",
    "https://*.amazon.es/*",
    "https://*.amazon.ca/*",
    "https://*.amazon.in/*",
    "https://*.amazon.com.au/*",
    "https://*.amazon.com.br/*",
    "https://*.amazon.com.mx/*",
    "https://*.coupangplay.com/*",
    "https://*.tving.com/*",
    "https://*.wavve.com/*",
    "https://*.watcha.com/*",
    "https://*.laftel.net/*",
    "https://serieson.naver.com/*",
    "https://tv.apple.com/*",
    "https://*.max.com/*",
    "https://*.hbomax.com/*",
    "https://www.hulu.com/*",
    "https://www.paramountplus.com/*",
    "https://www.peacocktv.com/*",
    "https://www.crunchyroll.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {},
    "toggle-click-through": {
      "suggested_key": {
        "default": "Alt+G"
      },
      "description": "__MSG_cmdClickThrough__"
    },
    "toggle-dodge": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "__MSG_cmdDodge__"
    },
    "toggle-mute": {
      "suggested_key": {
        "default": "Alt+M"
      },
      "description": "__MSG_cmdMute__"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://chzzk.naver.com/*",
        "https://play.sooplive.com/*",
        "https://vod.sooplive.com/*",
        "https://play.sooplive.co.kr/*",
        "https://vod.sooplive.co.kr/*",
        "https://www.twitch.tv/*",
        "https://www.netflix.com/*",
        "https://*.disneyplus.com/*",
        "https://*.primevideo.com/*",
        "https://*.amazon.com/*",
        "https://*.amazon.co.jp/*",
        "https://*.amazon.co.uk/*",
        "https://*.amazon.de/*",
        "https://*.amazon.fr/*",
        "https://*.amazon.it/*",
        "https://*.amazon.es/*",
        "https://*.amazon.ca/*",
        "https://*.amazon.in/*",
        "https://*.amazon.com.au/*",
        "https://*.amazon.com.br/*",
        "https://*.amazon.com.mx/*",
        "https://*.coupangplay.com/*",
        "https://*.tving.com/*",
        "https://*.wavve.com/*",
        "https://*.watcha.com/*",
        "https://*.laftel.net/*",
        "https://serieson.naver.com/*",
        "https://tv.apple.com/*",
        "https://*.max.com/*",
        "https://*.hbomax.com/*",
        "https://www.hulu.com/*",
        "https://www.paramountplus.com/*",
        "https://www.peacocktv.com/*",
        "https://www.crunchyroll.com/*"
      ],
      "js": [
        "shared/settings.js",
        "shared/protocol.js",
        "content/dodge.js",
        "content/subtitles.js",
        "content/heuristics.js",
        "content/overlay-ui.js",
        "content/relay.js",
        "content/doc-pip.js",
        "content/content.js"
      ],
      "css": [
        "content/overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chzzk.naver.com/live/*/chat",
        "https://www.youtube.com/live_chat*",
        "https://www.twitch.tv/popout/*/chat*"
      ],
      "js": [
        "content/chat-frame.js"
      ],
      "css": [
        "content/chat-frame.css"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "key": ""
}
