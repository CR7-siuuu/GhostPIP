{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "nativeMessaging",
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "chat_framing",
        "enabled": true,
        "path": "config/dnr_rules.json"
      }
    ]
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://*.youtube.com/*",
    "https://chzzk.naver.com/*",
    "https://*.sooplive.com/*",
    "https://*.sooplive.co.kr/*",
    "https://*.twitch.tv/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {},
    "toggle-click-through": {
      "suggested_key": {
        "default": "Alt+G"
      },
      "description": "__MSG_cmdClickThrough__"
    },
    "toggle-dodge": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "__MSG_cmdDodge__"
    },
    "toggle-mute": {
      "suggested_key": {
        "default": "Alt+M"
      },
      "description": "__MSG_cmdMute__"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "https://*.youtube.com/*",
        "https://chzzk.naver.com/*",
        "https://*.sooplive.com/*",
        "https://*.sooplive.co.kr/*",
        "https://*.twitch.tv/*"
      ],
      "js": [
        "shared/settings.js",
        "content/dodge.js",
        "content/content.js"
      ],
      "css": [
        "content/overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chzzk.naver.com/live/*/chat",
        "https://www.youtube.com/live_chat*",
        "https://www.twitch.tv/popout/*/chat*"
      ],
      "js": ["content/chat-frame.js"],
      "css": ["content/chat-frame.css"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "key": ""
}
